# Kjør med miljøet Local (standardprofilen i launchSettings.json).
# Syntetisk JWT med utløpt levetid og ugyldig signatur, kun til lokale eksempler.
# Et ekte Maskinporten-token kan limes inn i token-variabelen.
# Local krever kun en ikke-tom Bearer-verdi og validerer ikke JWT eller scopes.
@adresse = http://localhost:5080
@token = eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3Rlc3QubWFza2lucG9ydGVuLm5vLyIsImNvbnN1bWVyIjp7IklEIjoiMDE5Mjo5OTk4ODg3NzcifSwic2NvcGUiOiJkaWJrOmJ5Z2cvZnRiaWQubGVzIGRpYms6YnlnZy9mdGJpZC5lbmRyZSIsImV4cCI6MH0.a3VuLWxva2FsdC1la3NlbXBlbA

### Opprett prosjekt med flere adresser og matrikkelopplysninger
# Kjør dette først. Rider lagrer identifikatoren til de neste forespørslene.
POST {{adresse}}/api/ftbid
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Kommunenummer": "0301",
  "Gaardsnummer": 10,
  "Bruksnummer": 1,
  "Prosjektnavn": "Lokalt eksempelprosjekt",
  "System": "Lokale HTTP-eksempler",
  "FtIdType": "Ftbid",
  "AnsvarligSokerOrganisasjonsnummer": "123456789",
  "Bruksenhetsnummer": "H0101",
  "Adresser": ["Karl Johans gate 1", "Storgata 2"],
  "Matrikkelopplysninger": [
    { "Kommunenummer": "0301", "Gaardsnummer": 20, "Bruksnummer": 2, "Festenummer": 0, "Seksjonsnummer": 1 }
  ]
}

> {%
    client.test("Prosjektet er opprettet", function () {
        client.assert(response.status === 200, "Forventet HTTP 200");
    });
    if (response.status === 200) {
        client.global.set("opprettet_ftbid", response.body);
    }
%}

### Knytt kjent arkivreferanse til det opprettede prosjektet
# AR123456789 må være importert fra data/referansedata.eksempel.json.
POST {{adresse}}/api/ftbid/tilknytt
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Ftbid": "{{opprettet_ftbid}}", "Arkivreferanse": "AR123456789" }

### Søk i adresser og prosjektnavn
GET {{adresse}}/api/ftbid/sok?adresse=storgata&prosjektnavn=Lokalt%20eksempelprosjekt
Authorization: Bearer {{token}}

### Søk med FtID og type
GET {{adresse}}/api/ftbid/sok?ftid={{opprettet_ftbid}}&ftidtype=Ftbid
Authorization: Bearer {{token}}

### Søk med ansvarlig søker, bruksenhet og tiltaksnavn
GET {{adresse}}/api/ftbid/sok?ansvarligsokerorganisasjonsnummer=123456789&bruksenhetsnummer=H0101&tiltaksnavn=eksempel
Authorization: Bearer {{token}}

### Søk i alle fem matrikkelfelter
GET {{adresse}}/api/ftbid/sok?kommunenummer=0301&gaardsnummer=20&bruksnummer=2&festenummer=0&seksjonsnummer=1
Authorization: Bearer {{token}}

### Hent prosjekt og identifikasjonsmetadata
GET {{adresse}}/api/ftbid/{{opprettet_ftbid}}
Authorization: Bearer {{token}}

### Legg til en adresse
POST {{adresse}}/api/ftbid/{{opprettet_ftbid}}/adresser
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Adresse": "Storgata 3" }

### Fjern den ekstra adressen
DELETE {{adresse}}/api/ftbid/{{opprettet_ftbid}}/adresser?adresse=Storgata%203
Authorization: Bearer {{token}}

### Legg til en matrikkelenhet
POST {{adresse}}/api/ftbid/{{opprettet_ftbid}}/matrikkelopplysninger
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Kommunenummer": "0301", "Gaardsnummer": 30, "Bruksnummer": 3, "Festenummer": 0, "Seksjonsnummer": 2 }

### Fjern den ekstra matrikkelenheten
DELETE {{adresse}}/api/ftbid/{{opprettet_ftbid}}/matrikkelopplysninger?kommunenummer=0301&gaardsnummer=30&bruksnummer=3&festenummer=0&seksjonsnummer=2
Authorization: Bearer {{token}}

### Kontroller API og PostgreSQL
# Helseendepunktene er offentlige også uten token.
GET {{adresse}}/helse
Authorization: Bearer {{token}}

### Kontroller at API-prosessen svarer
GET {{adresse}}/helse/levende
Authorization: Bearer {{token}}

### Hent OpenAPI-dokumentet
GET {{adresse}}/openapi/v1.json
Authorization: Bearer {{token}}

### Åpne Swagger-dokumentasjonen
GET {{adresse}}/swagger/index.html
Authorization: Bearer {{token}}
