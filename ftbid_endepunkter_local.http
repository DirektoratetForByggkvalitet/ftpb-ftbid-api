# Kjør med miljøet Local (standardprofilen i launchSettings.json).
# Syntetisk JWT med utløpt levetid og ugyldig signatur, kun til lokale eksempler.
# Et ekte Maskinporten-token kan limes inn i token-variabelen.
# Local krever kun en ikke-tom Bearer-verdi og validerer ikke JWT eller scopes.
@adresse = http://localhost:5080
@token = eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL3Rlc3QubWFza2lucG9ydGVuLm5vLyIsImNvbnN1bWVyIjp7IklEIjoiMDE5Mjo5OTk4ODg3NzcifSwic2NvcGUiOiJkaWJrOmJ5Z2cvZnRiaWQubGVzIGRpYms6YnlnZy9mdGJpZC5lbmRyZSIsImV4cCI6MH0.a3VuLWxva2FsdC1la3NlbXBlbA

### Opprett prosjekt med strukturerte eiendommer (minst én eiendom kreves)
POST {{adresse}}/api/ftbid
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "Prosjektnavn": "Utvidelse av bygget",
  "Prosjektnr": "P-1001",
  "Tiltakstype": "Tilbygg",
  "System": "Søknadssystem",
  "Eiendom": [
    {
      "Eiendomsidentifikasjon": {
        "Kommunenummer": "0301",
        "Gaardsnummer": 124,
        "Bruksnummer": 55,
        "Festenummer": 2,
        "Seksjonsnummer": 0
      },
      "Adresse": [
        {
          "Adresselinje1": "Karl Johans gate 1",
          "Adresselinje2": "Hyttefelt 1",
          "Adresselinje3": null,
          "Postnr": "0154",
          "Poststed": "Oslo",
          "Landkode": "NO",
          "Gatenavn": "Karl Johans gate",
          "Husnr": "1",
          "Bokstav": null
        }
      ],
      "Bygningsnummer": "300827824",
      "Bolignummer": "H0201",
      "Kommunenavn": "Oslo"
    }
  ]
}

> {%
    if (response.status === 200) client.global.set("opprettet_ftbid", response.body);
%}

### Hent prosjektet og eiendoms-ID
GET {{adresse}}/api/ftbid/{{opprettet_ftbid}}
Authorization: Bearer {{token}}

> {%
    if (response.status === 200 && response.body[0].Eiendom.length > 0)
        client.global.set("eiendom_id", response.body[0].Eiendom[0].Id);
%}

### Legg til eiendom
POST {{adresse}}/api/ftbid/{{opprettet_ftbid}}/eiendom
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Eiendomsidentifikasjon": { "Kommunenummer": "0301", "Gaardsnummer": 21, "Bruksnummer": 30 }, "Adresse": [] }

### Erstatt hele eiendommen og adresselisten
PUT {{adresse}}/api/ftbid/{{opprettet_ftbid}}/eiendom/{{eiendom_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Eiendomsidentifikasjon": { "Kommunenummer": "0301", "Gaardsnummer": 124, "Bruksnummer": 55 },
  "Adresse": [{ "Adresselinje1": "Storgata 3", "Postnr": "0155", "Poststed": "Oslo", "Landkode": "NO" }],
  "Bygningsnummer": "300827824", "Bolignummer": "H0201", "Kommunenavn": "Oslo" }

### Søk (alle eiendomsfiltre må treffe samme eiendom)
GET {{adresse}}/api/ftbid/sok?kommunenummer=0301&gaardsnummer=124&bolignummer=H0201
Authorization: Bearer {{token}}

### Slett eiendom (også siste eiendom kan slettes)
DELETE {{adresse}}/api/ftbid/{{opprettet_ftbid}}/eiendom/{{eiendom_id}}
Authorization: Bearer {{token}}

### Knytt arkivreferanse
POST {{adresse}}/api/ftbid/tilknytt
Authorization: Bearer {{token}}
Content-Type: application/json

{ "Ftbid": "{{opprettet_ftbid}}", "Arkivreferanse": "AR123456789" }

### Helsesjekk
GET {{adresse}}/helse
